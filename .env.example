# Copy to .env and fill in. NEVER commit .env
DJANGO_SETTINGS_MODULE=config.settings.development
# Secret key: generate your own — uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
# (local dev tolerates the placeholder; production REQUIRES a real one, unique per environment)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── DATABASE: exactly ONE active DATABASE_URL line ─────────────
DATABASE_URL=sqlite:///var/dev.sqlite3
# ↑ current default: zero-setup local smoke-test (SQLite).
# Docker PostgreSQL 18 (real local dev): postgres://lms:lms@localhost:5432/lms
# Production (Render + Neon): paste Neon's connection string in Render's dashboard — never here.

# File storage backend for V1: "db" (free hosting F1) or "disk" (VPS R1)
FILES_BACKEND=db

# ── Email (V2-13 forgot-password) — production values live in Render, not here ──
# Local dev: leave everything unset -> reset emails print to the terminal (console).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your.reset.sender@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-gmail-app-password   (NOT the Gmail login password)
# DEFAULT_FROM_EMAIL=SyllaDesk <your.reset.sender@gmail.com>

# -- Apps Script mail (free reset-email route; values live in Render, not here) --
# APPS_SCRIPT_MAIL_URL=https://script.google.com/macros/s/.../exec
# APPS_SCRIPT_MAIL_TOKEN=same-long-random-token-as-inside-the-script
